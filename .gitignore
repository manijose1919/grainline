# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
sdist/
# NOTE: do NOT add `parts/` here, even though the stock Python .gitignore
# template carries it for zc.buildout. In GRAINLINE `parts/` is the conventional
# directory for a customer's DXF geometry - it is what `grainline init` creates
# and what the documentation tells them to use. Ignoring it means a shop that
# versions their job folder silently commits no part files, and finds out when a
# colleague clones the repo and the nest comes back empty.
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
ENV/

# --- Testing / coverage ---
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Type checkers / linters ---
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- Editors ---
.vscode/
.idea/
*.swp
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- GRAINLINE runtime artefacts ---
# Local shop data must never be committed.
*.grainline.db
data/
out/
nests/
scratch/

# --- Licensing: the signing key must NEVER enter version control ---
# The directory is excluded outright rather than relying on filename patterns:
# a future key called `signing.pem` would sail straight past a pattern list.
/secrets/
*.private.pem
*.pem
signing_key*
license.key
*.license

# --- Build segregation output (generated by `package`) ---
/public-free-build/
/private-pro-build/
